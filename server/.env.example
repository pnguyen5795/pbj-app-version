# Copy to .env and fill in your real key (or reuse the one in
# ../style-test/.env — same vendor, same key works).
TWELVE_LABS_API_KEY=your_api_key_here
PORT=4000

# Both from the same Clerk application as the frontend's
# VITE_CLERK_PUBLISHABLE_KEY (../.env.example) — Dashboard -> API Keys.
# CLERK_SECRET_KEY must never be exposed to the browser. The publishable
# key is duplicated here (unprefixed — no VITE_) because clerkMiddleware()
# on the backend needs it too, separately from Vite's frontend copy.
CLERK_SECRET_KEY=your_clerk_secret_key_here
CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key_here
