# Copy to deploy/.env. Real secrets stay out of Git and the iOS bundle.
# Use a URL-safe generated password or supply an encoded DATABASE_URL directly.
POSTGRES_PASSWORD=
CLERK_SECRET_KEY=
# Optional comma-separated authorized parties supported by your Clerk native setup.
CLERK_AUTHORIZED_PARTIES=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.1
TWELVE_LABS_API_KEY=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
# S3-compatible endpoint must be externally reachable by TwelveLabs for signed downloads.
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=0
# Set 1 only after reconciling earlier native AND legacy analyses into this account.
PBJ_REGISTRY_RECONCILED=0
