# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Frontend + backend secrets (Clerk keys, Twelve Labs key, etc.) never
# belong in version control (mirrors style-test/.gitignore).
.env
.env.local
server/.env
server/data/uploads/*
server/data/renders/*
server/data/tmp/*
!server/data/uploads/.gitkeep
!server/data/renders/.gitkeep
!server/data/tmp/.gitkeep

# Twelve Labs analysis cache: real content (scene descriptions of your own
# footage) and can grow large. Back it up: reanalysis is a paid operation
# requiring explicit authorization, not an ordinary cache rebuild.
cache/

# Native build artifacts and local signing state
.build/
DerivedData/
xcuserdata/
*.xcuserstate
*.mp4
*.mp4.verification.json
server/data/native/
server/data/personal-service/
docs/evidence/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
deploy/.env
ios/Configuration/Service.local.xcconfig
